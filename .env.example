# Copy this to .env.local for local development, and set the same keys in
# Vercel → Project Settings → Environment Variables for Preview/Production.

# OpenAI key used to draft notices (lib/generateNotice.js).
OPENAI_API_KEY=

# Stripe secret key (test mode: sk_test_..., live mode: sk_live_...).
# Used by api/checkout.js to create Checkout Sessions and by api/deliver.js
# to verify payment before releasing the generated document.
STRIPE_SECRET_KEY=
